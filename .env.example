# FreshUp Environment Configuration
# Copy to .env and fill in values

# Environment
ENVIRONMENT=local

# Database
DATABASE_URL=sqlite:///./data/freshup.db

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=freshup-admin
MINIO_SECRET_KEY=change-me-to-something-secure
MINIO_BUCKET=freshup
MINIO_USE_SSL=false

# Future: AWS S3 migration
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_USE_SSL=true
