# FreshUp Environment Configuration
# Copy to .env and fill in values

# Environment
ENVIRONMENT=local

# Database
DATABASE_URL=sqlite:///./data/freshup.db

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=freshup-admin
MINIO_SECRET_KEY=change-me-to-something-secure
MINIO_BUCKET=freshup
MINIO_USE_SSL=false

# Future: AWS S3 migration
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_USE_SSL=true

# JWT Authentication
# REQUIRED: Generate a secure secret key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Uncomment and replace with your generated key:
# JWT_SECRET_KEY=<paste-generated-key-here>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Proxy Trust Configuration
# Enable X-Forwarded-For header trust (default: false for security)
# Only enable if behind a trusted reverse proxy (nginx, Apache, AWS ALB, etc.)
TRUST_X_FORWARDED_FOR=false

# Trusted proxy IPs/CIDR ranges (comma-separated)
# Examples:
#   Single IP: TRUSTED_PROXIES=10.0.0.1
#   Multiple IPs: TRUSTED_PROXIES=10.0.0.1,192.168.1.1
#   CIDR range: TRUSTED_PROXIES=10.0.0.0/24,192.168.1.0/24
# Empty = trust NO proxies (fail-secure default - X-Forwarded-For will be ignored)
# You MUST explicitly list your proxy IPs to enable X-Forwarded-For trust
TRUSTED_PROXIES=

# Redis Configuration (for distributed rate limiting)
# Optional: If not set, rate limiter falls back to in-memory storage
# Format: redis://host:port/db or redis://host:port (defaults to db 0)
# Examples:
#   Local Redis: REDIS_URL=redis://localhost:6379/0
#   Redis with auth: REDIS_URL=redis://:password@localhost:6379/0
#   Redis Cloud: REDIS_URL=redis://user:password@redis-host.cloud:6379/0
# Empty = in-memory rate limiting (single-instance only)
REDIS_URL=

# Redis Connection Pool Configuration
# These settings tune the Redis connection pool for performance and reliability
# Adjust based on load testing and production metrics
# Defaults shown below are conservative and match redis-py defaults

# Maximum connections in the pool (default: 50)
# Rule of thumb: 2-3x expected peak concurrent requests
# Too small = connection contention, too large = wasted resources
REDIS_MAX_CONNECTIONS=50

# Connection timeout in seconds (default: 5.0)
# Timeout for establishing new Redis connections
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Socket operation timeout in seconds (default: 5.0)
# Timeout for read/write operations on established connections
REDIS_SOCKET_TIMEOUT=5.0

# Enable TCP keepalive (default: true)
# Maintains long-lived connections, prevents drops in cloud environments
REDIS_SOCKET_KEEPALIVE=true

# Health check interval in seconds (default: 30, 0=disabled)
# Periodic verification that connections remain valid
REDIS_HEALTH_CHECK_INTERVAL=30

# Retry operations on timeout (default: true)
# Automatically retry Redis operations that timeout
REDIS_RETRY_ON_TIMEOUT=true

# Ollama LLM Configuration
# URL for connecting to Ollama service
# Default: http://host.docker.internal:11434 (for Docker container-to-host communication)
# If running Ollama on host machine, use host.docker.internal
# If running Ollama in another container, use service name from docker-compose
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default Ollama model to use for LLM operations
# Format: model:version (e.g., llama3.1:8b, mistral:7b, codellama:13b)
# Ensure this model is pulled in Ollama before use: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Task polling interval in seconds (default: 10)
# How often to check for updates on long-running LLM tasks
# Lower values = more responsive but higher CPU usage
# Higher values = less responsive but lower resource usage
TASK_POLL_INTERVAL_SECONDS=10
