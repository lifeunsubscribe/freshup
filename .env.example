# FreshUp Environment Configuration
# Copy to .env and fill in values

# Environment
ENVIRONMENT=local

# Database
DATABASE_URL=sqlite:///./data/freshup.db

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=freshup-admin
MINIO_SECRET_KEY=change-me-to-something-secure
MINIO_BUCKET=freshup
MINIO_USE_SSL=false

# Future: AWS S3 migration
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_USE_SSL=true

# JWT Authentication
# Generate a secure secret key for production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# For local development, a key is auto-generated if not set
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
