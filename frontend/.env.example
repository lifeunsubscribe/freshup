# FreshUp Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Base URL
# Development: http://localhost:8000
# Production: https://api.freshup.example.com
VITE_API_URL=http://localhost:8000

# Development-only automatic login (see src/api/devLogin.ts).
# Put these in .env.development.local, not .env.local: the test runner also
# reads .env.local, and the tests expect no automatic login.
# VITE_DEV_LOGIN_EMAIL=
# VITE_DEV_LOGIN_PASSWORD=
